{
  "name": "inference-from-scratch",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive course: build and optimize an LLM inference engine, from a first Qwen3-0.6B token to continuous batching.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "artifacts": "python tools/build_artifacts.py",
    "artifacts:validate": "python tools/validate_artifacts.py",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "^16.0.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.23.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.545.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.181.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
